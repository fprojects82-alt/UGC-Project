# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLISHABLE_KEY
# Server-only. Used by intake-form notification / admin tasks. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Booking (Home §11 / Contact) ---
# Cal.com or Calendly embed URL. When empty, a labeled placeholder renders.
NEXT_PUBLIC_BOOKING_URL=

# --- Notifications (intake form → Phase 2) ---
# Optional: Slack/Resend/webhook target for new-lead notifications.
NOTIFY_WEBHOOK_URL=

# --- Analytics (optional) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
